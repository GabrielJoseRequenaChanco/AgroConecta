# Supabase configuration for AgroConecta
# Copy this file to .env and replace the values with your Supabase project settings.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: use a service role key for server-only operations.
# Do not expose this in client-side code or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
